{
  "name": "devmentor",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "npm run dev -w @devmentor/app",
    "build": "npm run build -w @devmentor/app",
    "storybook": "npm run storybook -w @devmentor/ui",
    "build-storybook": "npm run build-storybook -w @devmentor/ui",
    "start": "npm run start -w @devmentor/app",
    "lint": "eslint",
    "lint:tokens": "node scripts/check-tokens.mjs",
    "docs:design-system": "node --disable-warning=ExperimentalWarning scripts/design-system-doc.mjs",
    "docs:design-system:check": "node --disable-warning=ExperimentalWarning scripts/design-system-doc.mjs --check",
    "check:agents": "node scripts/check-agents.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:migrate": "npm run db:migrate -w @devmentor/db",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migration:create": "npm run db:migration:create -w @devmentor/db",
    "db:migration:check": "npm run db:migration:check -w @devmentor/db",
    "auth:set-password": "npm run auth:set-password -w @devmentor/core --",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:integration:setup": "agent-browser install",
    "test:storybook": "npm run test:storybook -w @devmentor/ui"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitest/coverage-v8": "^5.0.4",
    "agent-browser": "^0.39.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "jsdom": "^30.1.2",
    "testcontainers": "^12.2.1",
    "vitest": "^5.0.4"
  }
}
