{
  "name": "@devmentor/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./components/ui/*": "./src/components/ui/*.tsx",
    "./backend/*": "./src/backend/*.tsx",
    "./backend/api/*": "./src/backend/api/*.ts",
    "./lib/utils": "./src/lib/utils.ts",
    "./styles/*": "./src/styles/*"
