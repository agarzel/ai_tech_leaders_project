{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@devmentor/ui/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "vitest.setup.ts",
    "stories/**/*.ts",
    "stories/**/*.tsx",
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    "vitest.storybook.config.mts"
  ]
}
