# Copy to .env and adjust. Used by docker compose and by `npm run dev`.
POSTGRES_USER=devmentor
POSTGRES_PASSWORD=devmentor
POSTGRES_DB=devmentor

# Database connection for `npm run dev` (app outside Docker, db in Docker)
DATABASE_URL=postgres://devmentor:devmentor@localhost:5432/devmentor

# Secret for signing sessions (required, at least 32 characters). Generate your own: openssl rand -base64 32
AUTH_SECRET=replace-me-with-openssl-rand-base64-32-output
