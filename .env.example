# Copy to .env and adjust. Used by docker compose and by `npm run dev`.
POSTGRES_USER=devmentor
POSTGRES_PASSWORD=devmentor
POSTGRES_DB=devmentor

# Database connection for `npm run dev` (app outside Docker, db in Docker)
DATABASE_URL=postgres://devmentor:devmentor@localhost:5432/devmentor

# Secret for signing sessions (required, at least 32 characters). Generate your own: openssl rand -base64 32
AUTH_SECRET=replace-me-with-openssl-rand-base64-32-output

# Payments. One provider per process; required, no default.
#   fake   - development and tests: no network, a fake checkout page (refused when NODE_ENV=production)
#   stripe - Stripe Checkout, cards only; needs the two Stripe keys below
PAYMENTS_PROVIDER=fake
# Only for PAYMENTS_PROVIDER=stripe (test-mode keys in development). Never commit real values.
# STRIPE_SECRET_KEY=sk_test_replace-me
# STRIPE_WEBHOOK_SECRET=whsec_replace-me

# Protects POST /api/system/sweep (header x-sweep-token) and signs the fake provider's webhook events.
# Required, at least 32 characters. Generate your own: openssl rand -base64 32
SWEEP_SECRET=replace-me-with-openssl-rand-base64-32-output

# Public base URL of the app (http or https); Checkout success and cancel URLs are built from it.
APP_URL=http://localhost:3000
